# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.properties

# The Gradle wrapper jar is committed on purpose (Gradle's own recommendation):
# it makes ./gradlew work on a clean checkout and on CI with no bootstrap step.

# Android / IDE local state
local.properties
.cxx/
captures/
*.apk
*.aab
*.ap_
*.dex

# gomobile artifacts — the engine and the core bridge — are built by CI and dropped
# into app/libs (see README). They statically bundle the Go runtime and are tens of
# MB, so they are never committed; only the directory placeholder is.
app/libs/*.aar

# Signing material must never be committed.
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
