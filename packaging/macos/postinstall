#!/bin/bash
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 077
[[ "$EUID" == 0 ]] || exit 1
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
[[ "$(stat -f %u "$SCRIPT_DIR")" == 0 && ! -L "$SCRIPT_DIR" ]] || exit 1
SCRIPT_MODE="$(stat -f %Lp "$SCRIPT_DIR")"
(( (8#$SCRIPT_MODE & 18) == 0 )) || exit 1
[[ "$(stat -f %u "$SCRIPT_DIR/common.sh")" == 0 && ! -L "$SCRIPT_DIR/common.sh" ]] || exit 1
[[ "$(stat -f %Lp "$SCRIPT_DIR/common.sh")" == 644 ]] || exit 1
# shellcheck source=packaging/macos/common.sh
source "$SCRIPT_DIR/common.sh"
configure_paths ''
require_install_environment "$@"
finish_install
