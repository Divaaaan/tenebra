#!/bin/sh
set -eu

case "${1:-}" in
    configure)
        systemctl --system --no-ask-password daemon-reload
        /usr/lib/tenebra/tenebra-helper stage-package --manager=dpkg
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo 'Unsupported Tenebra post-install action.' >&2
        exit 1
        ;;
esac
