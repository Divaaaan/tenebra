{
  "name": "tenebra-desktop",
  "version": "0.4.4",
  "description": "Tenebra desktop client",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
