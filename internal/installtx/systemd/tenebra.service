[Unit]
Description=Tenebra VPN service host
Wants=network-online.target
After=network-online.target nss-lookup.target systemd-resolved.service
StartLimitIntervalSec=0
[Service]
Type=simple
ExecStart=/usr/lib/tenebra/tenebra-helper service-host
StateDirectory=tenebra/data
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tenebra/data
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
SendSIGKILL=yes
Delegate=no
SyslogIdentifier=tenebra
LimitNOFILE=infinity
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHOWN
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
[Install]
WantedBy=multi-user.target
